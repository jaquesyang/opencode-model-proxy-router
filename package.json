{
  "name": "@jaquesyang/opencode-model-proxy-router",
  "version": "0.0.1",
  "description": "Opencode plugin that routes model API requests to different HTTP proxies by wrapping fetch, with hot-reload.",
  "type": "module",
  "main": "./model-proxy-router.ts",
  "exports": {
    ".": {
      "import": "./model-proxy-router.ts",
      "types": "./model-proxy-router.ts"
    }
  },
  "files": [
    "model-proxy-router.ts",
    "model-proxy-router.json.example"
  ],
  "scripts": {
    "test": "node --test test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "proxy",
    "http-proxy"
  ],
  "author": "jaquesyang",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/jaquesyang/opencode-model-proxy-router.git"
  },
  "homepage": "https://github.com/jaquesyang/opencode-model-proxy-router#readme",
  "bugs": {
    "url": "https://github.com/jaquesyang/opencode-model-proxy-router/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "*"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.0.0",
    "@types/node": "^26.2.0",
    "typescript": "^5.0.0"
  }
}
